{
  "_comment": "Chep vao ~/.claude/settings.json va sua duong dan. Xem README de biet vi sao chon dung cac event nay.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["$HOME/cc-reminder-esp8266/host/cc_reminder_http.py", "IDLE"],
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["$HOME/cc-reminder-esp8266/host/cc_reminder_http.py", "WORKING"],
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["$HOME/cc-reminder-esp8266/host/cc_reminder_http.py", "INTERACT"],
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["$HOME/cc-reminder-esp8266/host/cc_reminder_http.py", "IDLE"],
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["$HOME/cc-reminder-esp8266/host/cc_reminder_http.py", "IDLE"],
            "async": true
          }
        ]
      }
    ]
  }
}
